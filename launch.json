{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Trainer Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "--extensionKind=[workspace]"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
